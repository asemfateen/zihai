# Backend environment variables
# In production, set these as environment variables on your hosting platform.
# NEVER commit real secrets to version control.

# Regenerate this for production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Frontend origin(s) for CORS (comma-separated or use ALLOWED_ORIGIN)
ALLOWED_ORIGIN=http://localhost:5173

# Frontend URL (used to build password reset links)
FRONTEND_URL=http://localhost:5173

# NODE_ENV=production  # Uncomment in production

# SMTP configuration for password reset emails
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_pass
# SMTP_FROM=noreply@zihai.app
